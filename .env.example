# Copy this file to .env and fill in your values.
# The .env file is git-ignored and never committed.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Optional: which chat model to use. Defaults to gpt-4o.
# Any model that supports JSON response formatting works (e.g. gpt-4o, gpt-4o-mini, gpt-4.1).
OPENAI_MODEL=gpt-4o

# Optional: sampling temperature (0.0 = most deterministic). Defaults to 0.2.
OPENAI_TEMPERATURE=0.2
